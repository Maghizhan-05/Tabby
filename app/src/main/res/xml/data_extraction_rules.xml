<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (dataExtractionRules), covering both cloud backup and
  device-to-device transfer. Same intent as backup_rules.xml: expense data and
  Supabase auth storage are excluded from every extraction path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
