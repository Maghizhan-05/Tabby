<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Tabby"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tabby">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Tabby">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              OAuth callback. The scheme/host must stay in lockstep with
              OAuthCallback.SCHEME / .HOST and with the Supabase Auth config.

              singleTask (above) so the callback reaches the EXISTING activity via
              onNewIntent rather than stacking a second copy, which would restart
              the router mid-exchange.

              This filter is necessarily exported, so any app can deliver a URL to
              it. OAuthCallback.parse validates scheme, host and boundary before a
              code is read, and PKCE means an intercepted code is useless without
              the verifier held in this process.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!--
                  Scheme and host only, deliberately.

                  Within a single intent-filter Android merges every <data>
                  attribute into a union, so declaring ANY android:path makes a
                  path mandatory — and the redirect Supabase actually sends
                  (`com.maghizhan.tabby://auth-callback`) carries no path at all,
                  so it would stop resolving. Verified on a device: with a path
                  declared, `resolve-activity` on the bare form returns
                  "No activity found".

                  Exactness is therefore enforced in code, where it CAN be
                  expressed precisely: OAuthCallback.parse accepts only the bare
                  host or a single trailing slash and rejects any other path,
                  port or look-alike host. The filter is the coarse door; the
                  parser is the lock.
                -->
                <data
                    android:host="auth-callback"
                    android:scheme="com.maghizhan.tabby" />
            </intent-filter>

            <!--
              The launcher long-press shortcut ("Log Expense"), Android's closest
              first-class equivalent to the iOS AppShortcut / Back-Tap binding.
              There is no Back-Tap equivalent on Android.

              Declared as meta-data rather than a second browsable intent-filter
              on purpose: the shortcut launches MainActivity directly with
              EXTRA_QUICK_ENTRY, so it needs no new exported URI surface. Adding
              a browsable `quick-entry` host would let any web page open the
              entry sheet, which buys nothing.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          The home-screen widget. exported="false": only the system
          AppWidgetHost needs to reach the receiver, and the broadcasts it
          handles (update/delete/options-changed) all originate there.
        -->
        <receiver
            android:name=".widget.TabbyWidgetReceiver"
            android:exported="false"
            android:label="Tabby">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tabby_widget_info" />
        </receiver>
        <!--
          The widget's configuration activity, started by the launcher when the
          widget is dropped (android:configure in tabby_widget_info).

          exported="true" is REQUIRED despite the receiver being private: the
          launcher is a different process and starts this activity directly, so
          an unexported one fails the placement with a SecurityException. It
          takes no action without a valid EXTRA_APPWIDGET_ID, which only the
          system supplies.

          excludeFromRecents + NoDisplay-free dialog theme: it is a placement
          step, not a destination, and should not linger in the task switcher.
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Tabby widget"
            android:theme="@style/Theme.Tabby">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
