// Secrets.example.xcconfig
// Copy this file to Secrets.xcconfig and fill in your Supabase project values.
// Secrets.xcconfig is gitignored and must NOT be committed.
//
// Canonical variable names use Supabase's NEW key naming. The app bridges these
// to the SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY build settings in Config/App.xcconfig.

// Your Supabase project URL.
// IMPORTANT: xcconfig treats "//" as a comment and the slashes do not reliably
// survive Info.plist substitution, so write the URL WITHOUT the scheme (host only).
// The app prepends https:// at runtime (SupabaseClientProvider.repairURLString).
//   e.g.  NEXT_PUBLIC_SUPABASE_URL=xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

// Your Supabase publishable key (formerly the "anon"/public key).
//   e.g.  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
